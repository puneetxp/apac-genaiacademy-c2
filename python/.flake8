[flake8]
max-line-length = 100
extend-ignore = E203,W503
# Generated by `php setup.php` (overwritten on every run): not linted here.
extend-exclude =
    app/api/isuper,
    app/api/islogin,
    app/api/ipublic,
    app/models,
    app/orm,
    app/api/routers.py,
    app/services/active_role_service.py,
    app/services/advance_booking_service.py,
