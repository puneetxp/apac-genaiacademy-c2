{
    "name": "livestock_transaction",
    "table": "livestock_transactions",
    "crud": {
        "isuper": [
            "c",
            "r",
            "u",
            "a",
            "d"
        ],
        "islogin": [
            "c",
            "r",
            "u",
            "d"
        ]
    },
    "enable": 1,
    "relations": {
        "livestock_listing": {
            "name": "listing_id",
            "key": "id",
            "table": "livestock_listings"
        },
        "seller": {
            "name": "seller_id",
            "key": "id",
            "table": "users"
        },
        "buyer": {
            "name": "buyer_id",
            "key": "id",
            "table": "users"
        }
    },
    "data": [
        {
            "name": "listing_id",
            "datatype": "number",
            "sql_attribute": "NOT NULL",
            "mysql_data": "bigint"
        },
        {
            "name": "seller_id",
            "datatype": "number",
            "sql_attribute": "NOT NULL",
            "mysql_data": "bigint"
        },
        {
            "name": "buyer_id",
            "datatype": "number",
            "sql_attribute": "NOT NULL",
            "mysql_data": "bigint"
        },
        {
            "name": "transaction_type",
            "datatype": "string",
            "sql_attribute": "NOT NULL COMMENT 'sale, breeding, lease'",
            "mysql_data": "varchar(50)"
        },
        {
            "name": "quantity",
            "datatype": "number",
            "sql_attribute": "NOT NULL DEFAULT 1",
            "mysql_data": "INT"
        },
        {
            "name": "agreed_price",
            "datatype": "number",
            "sql_attribute": "NOT NULL COMMENT 'Final agreed price in INR'",
            "mysql_data": "DECIMAL(12,2)"
        },
        {
            "name": "status",
            "datatype": "string",
            "sql_attribute": "DEFAULT 'inquiry' COMMENT 'inquiry, negotiation, agreed, completed, cancelled'",
            "mysql_data": "varchar(50)"
        },
        {
            "name": "buyer_message",
            "datatype": "text",
            "sql_attribute": "NULL COMMENT 'Initial inquiry message from buyer'",
            "mysql_data": "text"
        },
        {
            "name": "seller_response",
            "datatype": "text",
            "sql_attribute": "NULL COMMENT 'Response from seller'",
            "mysql_data": "text"
        },
        {
            "name": "buyer_contact_phone",
            "datatype": "string",
            "sql_attribute": "NULL",
            "mysql_data": "varchar(20)"
        },
        {
            "name": "buyer_contact_email",
            "datatype": "string",
            "sql_attribute": "NULL",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "delivery_required",
            "datatype": "boolean",
            "sql_attribute": "DEFAULT 0",
            "mysql_data": "TINYINT(1)"
        },
        {
            "name": "delivery_address",
            "datatype": "text",
            "sql_attribute": "NULL",
            "mysql_data": "text"
        },
        {
            "name": "delivery_latitude",
            "datatype": "number",
            "sql_attribute": "NULL",
            "mysql_data": "DECIMAL(10,8)"
        },
        {
            "name": "delivery_longitude",
            "datatype": "number",
            "sql_attribute": "NULL",
            "mysql_data": "DECIMAL(11,8)"
        },
        {
            "name": "health_guarantee_days",
            "datatype": "number",
            "sql_attribute": "DEFAULT 7 COMMENT '7-day health guarantee'",
            "mysql_data": "INT"
        },
        {
            "name": "health_guarantee_expires",
            "datatype": "Date",
            "sql_attribute": "NULL",
            "mysql_data": "timestamp"
        },
        {
            "name": "completed_at",
            "datatype": "Date",
            "sql_attribute": "NULL",
            "mysql_data": "timestamp"
        },
        {
            "name": "cancelled_at",
            "datatype": "Date",
            "sql_attribute": "NULL",
            "mysql_data": "timestamp"
        },
        {
            "name": "cancellation_reason",
            "datatype": "text",
            "sql_attribute": "NULL",
            "mysql_data": "text"
        },
        {
            "name": "notes",
            "datatype": "text",
            "sql_attribute": "NULL COMMENT 'Additional transaction notes'",
            "mysql_data": "text"
        }
    ]
}
