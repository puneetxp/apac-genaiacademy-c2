{
    "name": "satellite_observation",
    "table": "satellite_observations",
    "crud": {
        "isuper": [
            "r",
            "a",
            "d"
        ],
        "islogin": [
            "r",
            "a"
        ]
    },
    "enable": 1,
    "relations": {
        "farm": {
            "name": "farm_id",
            "key": "id",
            "table": "farms"
        }
    },
    "data": [
        {
            "name": "farm_id",
            "datatype": "number",
            "sql_attribute": "NOT NULL",
            "mysql_data": "bigint"
        },
        {
            "name": "scene_id",
            "datatype": "string",
            "sql_attribute": "NOT NULL COMMENT 'Sentinel-2 item id'",
            "mysql_data": "varchar(120)"
        },
        {
            "name": "observed_on",
            "datatype": "Date",
            "sql_attribute": "NOT NULL",
            "mysql_data": "date"
        },
        {
            "name": "source",
            "datatype": "string",
            "sql_attribute": "NOT NULL DEFAULT 'sentinel-2-l2a' COMMENT 'sentinel-2-l2a via Planetary Computer, or earth-engine'",
            "mysql_data": "varchar(50)"
        },
        {
            "name": "ndvi",
            "datatype": "number",
            "sql_attribute": "NULL COMMENT 'crop vigour, -1..1'",
            "mysql_data": "DECIMAL(5,3)"
        },
        {
            "name": "ndmi",
            "datatype": "number",
            "sql_attribute": "NULL COMMENT 'crop water content, -1..1'",
            "mysql_data": "DECIMAL(5,3)"
        },
        {
            "name": "ndre",
            "datatype": "number",
            "sql_attribute": "NULL COMMENT 'red-edge, nitrogen status, -1..1'",
            "mysql_data": "DECIMAL(5,3)"
        },
        {
            "name": "clear_pct",
            "datatype": "number",
            "sql_attribute": "NULL COMMENT 'share of the field free of cloud and shadow'",
            "mysql_data": "DECIMAL(5,1)"
        },
        {
            "name": "pixels",
            "datatype": "number",
            "sql_attribute": "NULL",
            "mysql_data": "INT"
        },
        {
            "name": "state",
            "datatype": "string",
            "sql_attribute": "NULL",
            "mysql_data": "varchar(100)"
        },
        {
            "name": "district",
            "datatype": "string",
            "sql_attribute": "NULL",
            "mysql_data": "varchar(100)"
        }
    ]
}