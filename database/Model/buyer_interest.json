{
    "name": "buyer_interest",
    "table": "buyer_interests",
    "crud": {
        "isuper": [
            "c",
            "r",
            "u",
            "a",
            "d"
        ],
        "islogin": [
            "c",
            "r",
            "a",
            "u",
            "d"
        ]
    },
    "enable": 1,
    "relations": {
        "listing": {
            "name": "listing_id",
            "key": "id",
            "table": "marketplace_listings"
        }
    },
    "data": [
        {
            "name": "listing_id",
            "datatype": "number",
            "sql_attribute": "NOT NULL",
            "mysql_data": "bigint"
        },
        {
            "name": "buyer_name",
            "datatype": "string",
            "sql_attribute": "NOT NULL",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "buyer_phone",
            "datatype": "string",
            "sql_attribute": "NOT NULL",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "buyer_email",
            "datatype": "string",
            "sql_attribute": "NULL",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "buyer_type",
            "datatype": "string",
            "sql_attribute": "NOT NULL COMMENT 'wholesaler, retailer, processor, cooperative'",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "interested_quantity",
            "datatype": "number",
            "sql_attribute": "NOT NULL COMMENT 'Quantity in kg'",
            "mysql_data": "INT"
        },
        {
            "name": "message",
            "datatype": "string",
            "sql_attribute": "NULL",
            "mysql_data": "text"
        },
        {
            "name": "status",
            "datatype": "string",
            "sql_attribute": "DEFAULT 'pending' COMMENT 'pending, contacted, agreed, cancelled'",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "delivery_latitude",
            "datatype": "number",
            "sql_attribute": "NULL COMMENT 'Buyer delivery location GPS latitude (optional)'",
            "mysql_data": "DECIMAL(10,8)"
        },
        {
            "name": "delivery_longitude",
            "datatype": "number",
            "sql_attribute": "NULL COMMENT 'Buyer delivery location GPS longitude (optional)'",
            "mysql_data": "DECIMAL(11,8)"
        },
        {
            "name": "delivery_pincode",
            "datatype": "string",
            "sql_attribute": "NULL COMMENT 'Buyer delivery location postal code'",
            "mysql_data": "varchar(10)"
        },
        {
            "name": "delivery_state",
            "datatype": "string",
            "sql_attribute": "NULL COMMENT 'Buyer delivery location state'",
            "mysql_data": "varchar(100)"
        },
        {
            "name": "delivery_district",
            "datatype": "string",
            "sql_attribute": "NULL COMMENT 'Buyer delivery location district'",
            "mysql_data": "varchar(100)"
        },
        {
            "name": "delivery_village",
            "datatype": "string",
            "sql_attribute": "NULL COMMENT 'Buyer delivery location village/VPO'",
            "mysql_data": "varchar(100)"
        },
        {
            "name": "delivery_address_line",
            "datatype": "string",
            "sql_attribute": "NULL COMMENT 'Full buyer delivery address'",
            "mysql_data": "varchar(255)"
        }
    ]
}