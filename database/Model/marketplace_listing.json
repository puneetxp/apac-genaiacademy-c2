{
    "name": "marketplace_listing",
    "table": "marketplace_listings",
    "crud": {
        "isuper": [
            "c",
            "r",
            "u",
            "a",
            "d"
        ],
        "islogin": [
            "c",
            "r",
            "u",
            "d"
        ],
        "public": [
            "r"
        ]
    },
    "enable": 1,
    "relations": {
        "farm": {
            "name": "farm_id",
            "key": "id",
            "table": "farms"
        },
        "user": {
            "name": "farmer_id",
            "key": "id",
            "table": "users"
        }
    },
    "data": [
        {
            "name": "farm_id",
            "datatype": "number",
            "sql_attribute": "NOT NULL",
            "mysql_data": "bigint"
        },
        {
            "name": "farmer_id",
            "datatype": "number",
            "sql_attribute": "NOT NULL",
            "mysql_data": "bigint"
        },
        {
            "name": "crop_type",
            "datatype": "string",
            "sql_attribute": "NOT NULL",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "crop_variety",
            "datatype": "string",
            "sql_attribute": "NULL",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "expected_harvest_date",
            "datatype": "Date",
            "sql_attribute": "NOT NULL",
            "mysql_data": "date"
        },
        {
            "name": "estimated_quantity",
            "datatype": "number",
            "sql_attribute": "NOT NULL COMMENT 'Quantity in kg'",
            "mysql_data": "INT"
        },
        {
            "name": "available_quantity",
            "datatype": "number",
            "sql_attribute": "NULL COMMENT 'Available quantity for booking in kg (defaults to estimated_quantity)'",
            "mysql_data": "INT"
        },
        {
            "name": "quality_grade",
            "datatype": "string",
            "sql_attribute": "NULL COMMENT 'A, B, C grade prediction'",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "location_state",
            "datatype": "string",
            "sql_attribute": "NOT NULL",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "location_district",
            "datatype": "string",
            "sql_attribute": "NOT NULL",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "farmer_contact_phone",
            "datatype": "string",
            "sql_attribute": "NULL",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "farmer_contact_email",
            "datatype": "string",
            "sql_attribute": "NULL",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "status",
            "datatype": "string",
            "sql_attribute": "DEFAULT 'active' COMMENT 'active, booked, harvested, cancelled'",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "delivery_latitude",
            "datatype": "number",
            "sql_attribute": "NULL COMMENT 'Delivery location GPS latitude (optional)'",
            "mysql_data": "DECIMAL(10,8)"
        },
        {
            "name": "delivery_longitude",
            "datatype": "number",
            "sql_attribute": "NULL COMMENT 'Delivery location GPS longitude (optional)'",
            "mysql_data": "DECIMAL(11,8)"
        },
        {
            "name": "delivery_pincode",
            "datatype": "string",
            "sql_attribute": "NULL COMMENT 'Delivery location postal code'",
            "mysql_data": "varchar(10)"
        },
        {
            "name": "delivery_village",
            "datatype": "string",
            "sql_attribute": "NULL COMMENT 'Delivery location village/VPO'",
            "mysql_data": "varchar(100)"
        },
        {
            "name": "delivery_address_line",
            "datatype": "string",
            "sql_attribute": "NULL COMMENT 'Full delivery address'",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "embedding",
            "datatype": "string",
            "sql_attribute": "NULL COMMENT 'Vector embedding for similarity matching (384 dimensions)'",
            "mysql_data": "vector(384)"
        },
        {
            "name": "embedding_cache_key",
            "datatype": "string",
            "sql_attribute": "NULL COMMENT 'Cache key for embedding to avoid regeneration'",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "price_per_unit",
            "datatype": "number",
            "sql_attribute": "NULL COMMENT 'Price per kg in INR'",
            "mysql_data": "DECIMAL(10,2)"
        }
    ]
}