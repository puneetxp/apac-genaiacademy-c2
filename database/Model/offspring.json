    "crud": {
        "isuper": [
            "c",
            "r",
            "u",
            "a",
            "d"
        ],
        "islogin": [
            "c",
            "r",
            "a",
            "u",
            "d"
        ]
    },
    "enable": 1,
    "relations": {
        "breeding_record": {
            "name": "breeding_record_id",
            "key": "id",
            "table": "breeding_records"
        },
        "livestock": {
            "name": "livestock_id",
            "key": "id",
            "table": "livestock"
        },
        "farmer": {
            "name": "farmer_id",
            "key": "id",
            "table": "users"
        }
    },
    "data": [
        {
            "name": "breeding_record_id",
            "datatype": "number",
            "sql_attribute": "NOT NULL",
            "mysql_data": "bigint"
        },
        {
            "name": "livestock_id",
            "datatype": "number",
            "sql_attribute": "NULL COMMENT 'Set once registered as livestock'",
