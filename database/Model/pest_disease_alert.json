{
    "name": "pest_disease_alert",
    "table": "pest_disease_alerts",
    "crud": {
        "isuper": [
            "c",
            "r",
            "u",
            "a",
            "d"
        ],
        "islogin": [
            "c",
            "r",
            "a",
            "u",
            "d"
        ]
    },
    "enable": 1,
    "relations": {
        "crop": {
            "name": "crop_id",
            "key": "id",
            "table": "crops"
        },
        "farm": {
            "name": "farm_id",
            "key": "id",
            "table": "farms"
        }
    },
    "data": [
        {
            "name": "crop_id",
            "datatype": "number",
            "sql_attribute": "NOT NULL",
            "mysql_data": "bigint"
        },
        {
            "name": "farm_id",
            "datatype": "number",
            "sql_attribute": "NOT NULL",
            "mysql_data": "bigint"
        },
        {
            "name": "pest_disease_name",
            "datatype": "string",
            "sql_attribute": "NOT NULL COMMENT 'Name of pest or disease'",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "alert_type",
            "datatype": "string",
            "sql_attribute": "NOT NULL COMMENT 'pest or disease'",
            "mysql_data": "varchar(50)"
        },
        {
            "name": "severity",
            "datatype": "string",
            "sql_attribute": "NOT NULL COMMENT 'low, medium, high'",
            "mysql_data": "varchar(50)"
        },
        {
            "name": "description",
            "datatype": "string",
            "sql_attribute": "NOT NULL",
            "mysql_data": "text"
        },
        {
            "name": "crop_stage",
            "datatype": "string",
            "sql_attribute": "NOT NULL COMMENT 'Growth stage when detected'",
            "mysql_data": "varchar(100)"
        },
        {
            "name": "weather_conditions",
            "datatype": "string",
            "sql_attribute": "NULL COMMENT 'JSON of weather conditions at detection'",
            "mysql_data": "text"
        },
        {
            "name": "organic_recommendations",
            "datatype": "string",
            "sql_attribute": "NULL COMMENT 'JSON array of organic treatment options'",
            "mysql_data": "text"
        },
        {
            "name": "chemical_recommendations",
            "datatype": "string",
            "sql_attribute": "NULL COMMENT 'JSON array of chemical treatment options'",
            "mysql_data": "text"
        },
        {
            "name": "prevention_measures",
            "datatype": "string",
            "sql_attribute": "NULL COMMENT 'JSON array of prevention measures'",
            "mysql_data": "text"
        },
        {
            "name": "timing_instructions",
            "datatype": "string",
            "sql_attribute": "NULL COMMENT 'Application timing guidance'",
            "mysql_data": "text"
        },
        {
            "name": "notification_sent",
            "datatype": "boolean",
            "sql_attribute": "DEFAULT 0",
            "mysql_data": "TINYINT(1)"
        },
        {
            "name": "notification_sent_at",
            "datatype": "Date",
            "sql_attribute": "NULL",
            "mysql_data": "timestamp"
        },
        {
            "name": "is_resolved",
            "datatype": "boolean",
            "sql_attribute": "DEFAULT 0",
            "mysql_data": "TINYINT(1)"
        },
        {
            "name": "resolved_at",
            "datatype": "Date",
            "sql_attribute": "NULL",
            "mysql_data": "timestamp"
        }
    ]
}
